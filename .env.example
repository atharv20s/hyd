# ── App ──
APP_NAME=hyd-ps2
APP_ENV=development
DEBUG=true

# ── Auth ──
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ──
POSTGRES_USER=hydps2
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hydps2
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hydps2:CHANGE_ME@localhost:5432/hydps2

# ── MongoDB ──
MONGO_URL=mongodb://localhost:27017
MONGO_DB=hydps2_memory

# ── Redis ──
REDIS_URL=redis://localhost:6380/0

# ── LLM (pick one) ──
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
LLM_MAX_OUTPUT_TOKENS=640
LLM_REASONING_EFFORT=minimal

# ── ElevenLabs ──
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_OPERATOR_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RECEIVING_DOMAIN=
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM=noreply@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── SMS (Textbee + Android phone with your SIM) ──
# Configure its inbound webhook only after deploying the API to public HTTPS.
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_DEVICE_ID=
TEXTBEE_WEBHOOK_SECRET=CHANGE_ME_generate_a_32_byte_random_secret
SMS_ENABLED=false
DAILY_SMS_CAP=20

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ── Scraper ──
SCRAPER_BASE_URL=http://localhost:8081

# ── Send caps ──
DAILY_EMAIL_CAP=50
DAILY_SEND_CAP=50
WORKER_CONCURRENCY=3
CACHE_TTL_SECONDS=900
# For deployed frontend builds, set NEXT_PUBLIC_WS_URL=wss://your-api-host
